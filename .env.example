# ==============================================================
# Dokumenku — contoh environment variable
#
# Lokal   : salin menjadi .env.local lalu isi.
# Vercel  : isi semua di Project → Settings → Environment Variables.
# Jangan pernah commit nilai asli. File .env* sudah di-ignore git.
# ==============================================================

# --- Login -----------------------------------------------------
# Hanya email ini yang boleh masuk (boleh beberapa, pisahkan koma).
OWNER_EMAIL=""
# Kunci penandatangan cookie sesi, acak dan minimal 32 karakter.
# Gunakan nilai BERBEDA untuk lokal dan produksi.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Google OAuth & Drive ---------------------------------------
# Google Cloud Console → Google Auth Platform → Clients (Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Dibuat dengan: npm run drive:token
# Untuk produksi, buat ulang SETELAH aplikasi OAuth di-publish
# (token dari status "Testing" kedaluwarsa dalam 7 hari).
GOOGLE_REFRESH_TOKEN=""
# Opsional, disarankan. Dibuat dengan: npm run drive:folder
# Jangan pakai folder yang dibuat manual (scope drive.file tidak bisa mengaksesnya).
GOOGLE_DRIVE_FOLDER_ID=""

# Opsional, untuk fitur "Impor dari Google Drive" (Google Picker).
# API key dibatasi ke Google Picker API dan domain aplikasi. Lihat README.
GOOGLE_PICKER_API_KEY=""
# Opsional. Nomor project Google Cloud; default dari awalan GOOGLE_CLIENT_ID.
GOOGLE_CLOUD_PROJECT_NUMBER=""

# --- Supabase ---------------------------------------------------
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""
# RAHASIA & khusus server (service_role / secret key).
# Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
